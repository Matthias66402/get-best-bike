# LLM / Embeddings (PydanticAI-Modellnamen, z. B. openai:gpt-5-mini, anthropic:claude-sonnet-5-5, ollama:llama3.3)
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5-mini
# Projektlimit des API-Keys (Anfragen pro Minute und Modell); alle Agenten drosseln sich darauf; 0 = keine Drosselung
# Token-Limit des API-Keys je Modell (Tokens pro Minute, Eingabe + max. Ausgabe); 0 = keine Drosselung
LLM_TOKENS_PER_MINUTE=0
LLM_REQUESTS_PER_MINUTE=0
# Reasoning-Aufwand des Beraters (minimal, low, medium, high); leer = Standard des Modells
LLM_REASONING_EFFORT=
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIM=1536
# Kleines Modell, das Suchtreffer der Wissensbasis auf Relevanz prüft; leer = aus
RELEVANCE_MODEL=openai:gpt-4o-mini
# Recherche-Agent, an den der Berater die Suche in der Wissensbasis delegiert
RESEARCH_MODEL=openai:gpt-4.1-mini
# Bestimmt vorab Kategorie, Budget, Körpermaße und Suchanfragen; leer = aus
INTAKE_MODEL=openai:gpt-4o-mini

# Datenbank
DATABASE_URL=postgresql+asyncpg://bike:bike@localhost:5441/bike
TEST_DATABASE_URL=postgresql+asyncpg://bike:bike@localhost:5441/bike_test

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Websuche (https://app.tavily.com, Free-Tier 1.000 Credits/Monat); leer = Websuche aus
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
# Treffer je Suche
WEB_SEARCH_MAX_RESULTS=5
# Wie lange Suchergebnisse und Produktseiten zwischengespeichert werden (Stunden)
WEB_CACHE_HOURS=24
# Zeitlimit für Anfragen an externe Dienste in Sekunden
HTTP_TIMEOUT_SECONDS=20

CORS_ORIGINS=http://localhost:5181

# Tracing-Backend: langfuse, langsmith oder none
TRACING_BACKEND=langfuse

# Tracing mit Langfuse (https://cloud.langfuse.com → Projekt → Settings → API Keys); ohne Keys aus
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# false schaltet das Tracing trotz Keys ab
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trennt Test- von Produktionsdaten in Langfuse (Kleinbuchstaben, z. B. development, production)
LANGFUSE_TRACING_ENVIRONMENT=development

# Tracing mit LangSmith (TRACING_BACKEND=langsmith; https://smith.langchain.com → Settings → API Keys); ohne Key aus
# false schaltet das Tracing trotz Key ab
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=get-best-bike
# Region des Workspaces, EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
